# ─── MinhaVenda Frontend — Environment Variables ──────────────────────────────
# Copy this file to .env for local development.
# NEVER commit .env to git.
#
# Production values are set in Vercel dashboard or vercel.json.

# ─── API ──────────────────────────────────────────────────────────────────────
# Dev: use relative path — Vite dev server proxies /api → http://localhost:3000
# Prod (Vercel): use absolute Render URL — no proxy available at build time
VITE_API_URL=/api

# ─── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=MinhaVenda
VITE_APP_VERSION=1.0.0
